# انسخ هذا الملف إلى .env.local (للتطوير المحلي) و.env (لأوامر Prisma CLI)
#   cp .env.example .env.local
#   cp .env.local .env

# رابط Prisma Accelerate — يبدأ بـ prisma://accelerate.prisma-data.net/?api_key=...
# احصل عليه من https://console.prisma.io بعد ربط مشروعك بقاعدة بيانات Neon
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=__API_KEY__"

# رابط Neon المباشر (postgresql://...) — يُستخدم فقط لأوامر Prisma CLI
# (db push / migrate / seed) لأنها لا تدعم روابط Accelerate
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# نص عشوائي طويل لتوقيع جلسات الدخول (JWT) — لا تشاركه أبداً
SESSION_SECRET="غيّر-هذا-إلى-نص-عشوائي-طويل-وسري"

# مفتاح دخول لوحة الأدمن (/admin) — نص عشوائي طويل وسري.
# إلزامي: بدون ضبط هذا المتغيّر، كل طلبات الأدمن تُرفض تلقائياً.
ADMIN_SECRET="غيّر-هذا-إلى-نص-عشوائي-طويل-وسري-آخر"

# للتحقق التلقائي من معاملات USDT (BEP20 / BNB Smart Chain) عبر Etherscan V2 API
# احصل عليه من https://etherscan.io/apis (مجاني)
ETHERSCAN_API_KEY=""

# اختياري: للتحقق التلقائي من معاملات USDT (TRC20 / Tron) عبر TronGrid
# بدونه يعمل التحقق لكن بحدود معدل طلبات أقل. احصل عليه من https://trongrid.io
TRONGRID_API_KEY=""
