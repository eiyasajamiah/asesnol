generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  referralCode String     @unique
  referredBy   String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  isEarlyBird  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscriptions  Subscription[]
  transactions   Transaction[]
  referralsMade  Referral[]     @relation("UserReferrals")
  referredByUser User?          @relation("UserReferrals", fields: [referredBy], references: [id])
  referredUsers  User[]         @relation("UserReferrals")

  @@map("users")
}

model Plan {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal? @db.Decimal(10, 2)
  features     Json?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String
  planId        String
  status        SubscriptionStatus @default(PENDING)
  billingCycle  BillingCycle       @default(MONTHLY)
  licenseKey    String?            @unique
  paymentMethod PaymentMethod      @default(CRYPTO)
  startDate     DateTime?
  endDate       DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Transaction {
  id             String            @id @default(uuid())
  userId         String
  subscriptionId String?
  type           TransactionType
  amount         Decimal           @db.Decimal(10, 2)
  currency       String            @default("USD")
  description    String?
  status         TransactionStatus @default(COMPLETED)
  txHash         String?           @unique
  network        String?
  createdAt      DateTime          @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@map("transactions")
}

model Referral {
  id               String         @id @default(uuid())
  referrerId       String
  referredId       String         @unique
  status           ReferralStatus @default(PENDING)
  commissionRate   Decimal        @default(20) @db.Decimal(5, 2)
  commissionAmount Decimal        @default(0) @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  paidAt           DateTime?

  referrer User @relation("UserReferrals", fields: [referrerId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

model BotRelease {
  id          String   @id @default(uuid())
  version     String
  title       String
  description String?
  fileName    String
  fileKey     String   @unique
  fileSizeKb  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("bot_releases")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

enum PaymentMethod {
  CRYPTO
}

enum TransactionType {
  SUBSCRIPTION_PURCHASE
  REFERRAL_COMMISSION
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReferralStatus {
  PENDING
  ACTIVE
}
